# /etc/agentnode-mcp/cert.env -- NON-secret renewal settings (root 0600 all the same).
# The KAS API login/password are NOT here: they are root-only files under
# /etc/agentnode-mcp/credentials/{kas_login,kas_password}, passed to the unit via LoadCredential=.
DOMAIN=mcp.agentnode.net
EMAIL=ops@agentnode.net
# Let's Encrypt staging for the pre-launch drill, production afterwards:
#   https://acme-staging-v02.api.letsencrypt.org/directory
#   https://acme-v02.api.letsencrypt.org/directory
ACME_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
DNS_PROVIDER=allinkl
# Ask public resolvers (not the local stub) whether the TXT record has propagated.
DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
LEGO_BIN=/opt/agentnode/bin/lego
LEGO_PATH=/var/lib/agentnode-mcp/lego
TLS_DIR=/etc/agentnode-mcp/tls
# MUST equal LISTEN_ADDR in nginx-mcp.conf (the public IPv4): the post-install serve check
# connects there with SNI mcp.agentnode.net.
SERVE_CHECK_ADDR=2.28.194.41
STATE_DIR=/var/lib/agentnode-mcp/cert
RENEW_DAYS=30
ATTEMPTS=3
KEEP_RELEASES=5
