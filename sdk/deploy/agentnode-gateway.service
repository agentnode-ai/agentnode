[Unit]
# The control plane. It holds the pairing state, this gateway's signing identity, every paired
# client's token material and the replay ledger -- and it cannot drive a container runtime.
#
# That last part is the point. This account is in no group that can reach docker or podman, and
# the only way it gets code run is by asking the worker over a socket. ALPHA-BOUNDARY-0001.
Description=AgentNode gateway (control plane)
Documentation=https://agentnode.ai/docs/sandbox
After=network-online.target agentnode-worker.service
Wants=agentnode-worker.service

[Service]
Type=simple
User=agentnode-gateway
Group=agentnode-gateway
# The only supplementary group it has, and the only thing that group can reach: the worker's
# socket. Not docker, and not anything else.
SupplementaryGroups=agentnode-bridge

# Where the worker is, and where this listens, are both deployment configuration and nothing else.
# No product code knows or asks which host the worker is on, and the topology in every record is
# derived from the address rather than declared beside it.
#
# That is the SEAM, and it is not the same as the move being done. This build reaches a worker
# over a unix socket AND NOTHING ELSE -- `from_address` refuses any other scheme and says so.
# Moving the worker to its own machine needs a transport that does not exist yet; what has been
# built is that when it does, it is this value that changes and not the product.
#
# The bind address defaults to 127.0.0.1 there: a gateway is reachable from this machine only
# until somebody decides otherwise, and deciding otherwise is editing that file and opening a
# port, both on purpose.
EnvironmentFile=/etc/agentnode/gateway.env

ExecStart=/opt/agentnode/venv/bin/agentnode gateway start \
    --dir /var/lib/agentnode/state \
    --host ${AGENTNODE_HOST} \
    --port ${AGENTNODE_PORT}

Restart=always
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=

# It serves clients and it speaks to the worker's socket. Nothing else.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# It has no container runtime and no way to get one: not in the docker group, not in any group
# that reaches a runtime socket, and nothing on this machine will run a container for it except
# the worker, which answers one socket and checks who is calling.
#
# Its own state and nothing more. The state directory is where the secrets are, and the gateway
# stops itself if that directory ever stops being private -- see gateway/securedir.py.
StateDirectory=agentnode
StateDirectoryMode=0700
ReadWritePaths=/var/lib/agentnode

[Install]
WantedBy=multi-user.target
