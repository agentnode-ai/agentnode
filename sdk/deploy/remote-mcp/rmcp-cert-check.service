[Unit]
Description=remote MCP origin: independent served-certificate + renewal-health check (alerts on failure or < 21 days)
Wants=network-online.target
After=network-online.target
OnFailure=rmcp-alert@%n.service

[Service]
Type=oneshot
Environment=PYTHONPATH=/opt/agentnode/sdk
# Connects to the PUBLIC name as a client does, so it checks what the world is served.
ExecStart=/opt/agentnode/venv/bin/python -m agentnode_sdk.remote_mcp.cert_check \
    --domain mcp.agentnode.net --min-days 21 \
    --installed /etc/agentnode-mcp/tls/live/fullchain.pem \
    --timer rmcp-cert-renew.timer --stamp /var/lib/agentnode-mcp/cert/last-success \
    --max-renew-age-hours 36
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
